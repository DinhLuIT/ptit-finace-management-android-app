<?xml version="1.0" encoding="utf-8"?>
<!-- Component tái sử dụng: Giao diện Trạng thái Trống (Empty State).
     Include vào các Fragment/Activity và sử dụng code để set icon, title, subtitle, button text.
     Thiết kế: Icon lớn + Tiêu đề đậm + Text phụ + Nút hành động (pill shape). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_empty_state"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <!-- Icon/Emoji minh họa kích thước lớn -->
    <TextView
        android:id="@+id/tv_empty_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📭"
        android:textSize="64sp" />

    <!-- Tiêu đề chính (in đậm, color primary) -->
    <TextView
        android:id="@+id/tv_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/empty_default_title"
        android:textColor="@color/color_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Mô tả phụ hướng dẫn người dùng -->
    <TextView
        android:id="@+id/tv_empty_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingHorizontal="16dp"
        android:text="@string/empty_default_subtitle"
        android:textColor="@color/color_text_secondary"
        android:textSize="14sp" />

    <!-- Nút hành động (CTA) – bo tròn hoàn toàn (Pill shape) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_empty_action"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="32dp"
        android:text="@string/btn_add_new"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:visibility="gone"
        app:cornerRadius="22dp" />

</LinearLayout>
