<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FinanceManagerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FinaceManager">

        <!-- Splash Screen (LAUNCHER) -->
        <activity
            android:name=".activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FinaceManager.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PIN Lock -->
        <activity
            android:name=".activity.PinLockActivity"
            android:exported="false" />

        <!-- Main (Bottom Navigation Host) -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="false" />

        <!-- Add Transaction -->
        <activity
            android:name=".activity.AddTransactionActivity"
            android:exported="false" />

        <!-- Pot Detail -->
        <activity
            android:name=".activity.PotDetailActivity"
            android:exported="false" />

        <!-- Statistics -->
        <activity
            android:name=".activity.StatisticsActivity"
            android:exported="false" />

        <!-- Savings Goals List -->
        <activity
            android:name=".activity.SavingsGoalsActivity"
            android:exported="false" />

        <!-- Goal Detail -->
        <activity
            android:name=".activity.GoalDetailActivity"
            android:exported="false" />

        <!-- Recurring Transactions -->
        <activity
            android:name=".activity.RecurringTransactionsActivity"
            android:exported="false" />

        <!-- Exchange Rate -->
        <activity
            android:name=".activity.ExchangeRateActivity"
            android:exported="false" />

        <!-- FileProvider cho chia sẻ file CSV an toàn -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

    </application>

</manifest>