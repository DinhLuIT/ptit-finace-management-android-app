<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FinaceManager">

        <!-- Splash Screen (LAUNCHER) -->
        <activity
            android:name=".activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FinaceManager.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PIN Lock -->
        <activity
            android:name=".activity.PinLockActivity"
            android:exported="false" />

        <!-- Main (Bottom Navigation Host) -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="false" />

        <!-- Add Transaction -->
        <activity
            android:name=".activity.AddTransactionActivity"
            android:exported="false" />

        <!-- Pot Detail -->
        <activity
            android:name=".activity.PotDetailActivity"
            android:exported="false" />

        <!-- Statistics -->
        <activity
            android:name=".activity.StatisticsActivity"
            android:exported="false" />

    </application>

</manifest>